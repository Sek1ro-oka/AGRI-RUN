<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="true">
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/fm_tab_selected" />
            <corners
                android:radius="99dp" />
        </shape>
    </item>
    <item>
        <ripple
            android:color="@color/fm_ripple">
            <item
                android:id="@android:id/mask">
                <shape>
                    <solid
                        android:color="#FFFFFFFF" />
                    <corners
                        android:radius="99dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
