<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fm_surface"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fm_surface"
        android:minHeight="?attr/actionBarSize"
        app:title="@string/app_settings_title"
        app:titleTextColor="@color/campus_ink" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_3xl">
            <TextView
            style="@style/Text.Unloop.Note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3xl"
                android:layout_marginTop="@dimen/space_3xl"
                android:letterSpacing="0.08"
                android:text="@string/app_settings_section_general"
                android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xl"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_xl"
                app:cardBackgroundColor="@color/fm_surface"
                app:cardCornerRadius="@dimen/radius_sheet"
                app:cardElevation="0dp"
                app:strokeColor="@color/campus_card_stroke"
                app:strokeWidth="@dimen/stroke_edge">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_2xl">
                    <LinearLayout
                        android:id="@+id/rowAppearance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/space_2xl">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="@dimen/space_xl" android:background="@drawable/bg_campus_entry_icon" android:padding="@dimen/space_lg" android:src="@drawable/ic_fm_display" android:contentDescription="@null" app:tint="@color/fm_link" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                            style="@style/Text.Unloop.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/app_settings_appearance_title"
                                android:textStyle="bold" />
                            <TextView
                            style="@style/Text.Unloop.Caption"
                                android:id="@+id/textAppearanceValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_hair"
                                />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_campus_chevron_right" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/fm_border" />
                    <LinearLayout
                        android:id="@+id/rowLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/space_2xl">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="@dimen/space_xl" android:background="@drawable/bg_campus_entry_icon" android:padding="@dimen/space_lg" android:src="@drawable/ic_fm_globe" android:contentDescription="@null" app:tint="@color/fm_link" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                            style="@style/Text.Unloop.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/app_settings_language_title"
                                android:textStyle="bold" />
                            <TextView
                            style="@style/Text.Unloop.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_hair"
                                android:text="@string/app_settings_language_value"
                                />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_campus_soft_pill"
                            android:paddingHorizontal="@dimen/space_md"
                            android:paddingVertical="@dimen/space_xs"
                            android:text="@string/app_settings_language_badge"
                            android:textColor="@color/campus_mint_dark"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/fm_border" />
                    <LinearLayout
                        android:id="@+id/rowActivation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/space_2xl">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="@dimen/space_xl" android:background="@drawable/bg_campus_entry_icon" android:padding="@dimen/space_lg" android:src="@drawable/ic_fm_key" android:contentDescription="@null" app:tint="@color/fm_link" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                            style="@style/Text.Unloop.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/app_settings_activation_title"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/imageActivationChevron"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_campus_chevron_right" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/fm_border" />
                    <LinearLayout
                        android:id="@+id/rowTimetableWidget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/space_2xl">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="@dimen/space_xl" android:background="@drawable/bg_campus_entry_icon" android:padding="@dimen/space_lg" android:src="@drawable/ic_campus_widget" android:contentDescription="@null" app:tint="@color/fm_link" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                            style="@style/Text.Unloop.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/app_settings_widget_title"
                                android:textStyle="bold" />
                            <TextView
                            style="@style/Text.Unloop.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_hair"
                                android:text="@string/app_settings_widget_subtitle"
                                />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/fm_border" />
                    <LinearLayout
                        android:id="@+id/rowReminders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/space_2xl">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="@dimen/space_xl" android:background="@drawable/bg_campus_entry_icon" android:padding="@dimen/space_lg" android:src="@drawable/ic_study_clock" android:contentDescription="@null" app:tint="@color/fm_link" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                            style="@style/Text.Unloop.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/app_settings_reminders_title"
                                android:textStyle="bold" />
                            <TextView
                            style="@style/Text.Unloop.Caption"
                                android:id="@+id/textRemindersValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_hair"
                                android:text="@string/app_settings_reminders_subtitle"
                                />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
            style="@style/Text.Unloop.Note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3xl"
                android:layout_marginTop="@dimen/space_3xl"
                android:letterSpacing="0.08"
                android:text="@string/app_settings_section_data"
                android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xl"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_xl"
                app:cardBackgroundColor="@color/fm_surface"
                app:cardCornerRadius="@dimen/radius_sheet"
                app:cardElevation="0dp"
                app:strokeColor="@color/campus_card_stroke"
                app:strokeWidth="@dimen/stroke_edge">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_2xl">
                    <LinearLayout
                        android:id="@+id/rowRunHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/space_2xl">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="@dimen/space_xl" android:background="@drawable/bg_campus_entry_icon" android:padding="@dimen/space_lg" android:src="@drawable/ic_campus_history" android:contentDescription="@null" app:tint="@color/fm_link" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                            style="@style/Text.Unloop.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/run_history_title"
                                android:textStyle="bold" />
                            <TextView
                            style="@style/Text.Unloop.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_hair"
                                android:text="@string/run_history_entry_subtitle"
                                />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_campus_chevron_right" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/fm_border" />
                    <LinearLayout
                        android:id="@+id/rowBackupExport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/space_2xl">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="@dimen/space_xl" android:background="@drawable/bg_campus_entry_icon" android:padding="@dimen/space_lg" android:src="@drawable/ic_fm_backup" android:contentDescription="@null" app:tint="@color/fm_link" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                            style="@style/Text.Unloop.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/backup_export_action"
                                android:textStyle="bold" />
                            <TextView
                            style="@style/Text.Unloop.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_hair"
                                android:text="@string/backup_export_hint"
                                />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_campus_chevron_right" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/fm_border" />
                    <LinearLayout
                        android:id="@+id/rowBackupImport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/space_2xl">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="@dimen/space_xl" android:background="@drawable/bg_campus_entry_icon" android:padding="@dimen/space_lg" android:src="@drawable/ic_fm_restore" android:contentDescription="@null" app:tint="@color/fm_link" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                            style="@style/Text.Unloop.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/backup_import_action"
                                android:textStyle="bold" />
                            <TextView
                            style="@style/Text.Unloop.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_hair"
                                android:text="@string/backup_import_hint"
                                />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_campus_chevron_right" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/rowUpdate"
                style="@style/Widget.Unloop.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_margin="@dimen/space_3xl"
                android:text="@string/home_update_title"
                app:icon="@drawable/ic_campus_update" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
