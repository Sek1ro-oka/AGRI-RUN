<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_setup_bg">
    <LinearLayout
        android:id="@+id/runScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="@dimen/space_xl"
            android:gravity="center_vertical">
            <ImageButton
                android:id="@+id/buttonRunBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_campus_back"
                android:padding="@dimen/space_xl"
                android:contentDescription="@string/campus_back" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/campus_title"
                android:textColor="@color/campus_ink"
                android:textSize="@dimen/text_hero"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/buttonAdvanced"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_campus_settings"
                android:padding="@dimen/space_xl"
                android:contentDescription="@string/run_settings" />
        </LinearLayout>
        <TextView
        style="@style/Text.Unloop.Action"
            android:id="@+id/textRunStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_5xl"
            android:paddingBottom="@dimen/space_lg"
            android:text="@string/run_status_idle"
            android:accessibilityLiveRegion="polite" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_hair"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_3xl"
            android:id="@+id/runStats">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                style="@style/Text.Unloop.Note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/campus_stat_distance"
                    />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">
                    <TextView
                    style="@style/Text.Unloop.Metric"
                        android:id="@+id/textDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textStyle="bold" />
                    <TextView
                    style="@style/Text.Unloop.Note"
                        android:id="@+id/textDistanceUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:text="km"
                        />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                style="@style/Text.Unloop.Note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/campus_stat_time"
                    />
                <TextView
                style="@style/Text.Unloop.Metric"
                    android:id="@+id/textRunTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                style="@style/Text.Unloop.Note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/campus_stat_pace"
                    />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textPace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="@dimen/text_metric"
                        android:textStyle="bold" />
                    <TextView
                    style="@style/Text.Unloop.Note"
                        android:id="@+id/textPaceUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:text="/km"
                        />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_weight="1">
            <org.maplibre.android.maps.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <TextView
                android:id="@+id/textMapTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_md"
                android:background="@drawable/bg_campus_chip"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_xs"
                android:text="@string/campus_map_tag"
                android:textColor="@color/campus_ink"
                android:textSize="@dimen/text_caption"
                app:drawableStartCompat="@drawable/ic_campus_dot" />
            <TextView
                android:id="@+id/textMapLayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="@dimen/space_7xl"
                android:background="@drawable/bg_campus_chip"
                android:clickable="true"
                android:contentDescription="@string/campus_map_layer_default_action"
                android:drawablePadding="5dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_xs"
                android:text="@string/campus_map_layer_satellite"
                android:textColor="@color/campus_mint_dark"
                android:textSize="@dimen/text_caption"
                app:drawableStartCompat="@drawable/ic_campus_layers" />
            <TextView
                android:id="@+id/textCoordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_margin="@dimen/space_md"
                android:background="@drawable/bg_campus_chip_dark"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_xs"
                android:text="30.25610°N 119.72360°E"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_caption" />
            <TextView
            style="@style/Text.Unloop.Caption"
                android:id="@+id/textMapMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_md"
                android:background="@drawable/bg_campus_chip"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_xs"
                android:text="@string/campus_map_mode"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/drawBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginHorizontal="@dimen/space_md"
                android:layout_marginTop="@dimen/space_8xl"
                android:background="@drawable/bg_campus_draw_bar"
                android:elevation="@dimen/elevation_low"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_xl"
                android:paddingVertical="@dimen/space_md"
                android:visibility="gone">
                <TextView
                    android:id="@+id/textDrawBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/campus_draw_banner"
                    android:textColor="@color/campus_ink"
                    android:textSize="@dimen/text_label" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDrawUndo"
                        style="@style/Widget.Unloop.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="@dimen/touch_min"
                        android:paddingHorizontal="@dimen/space_lg"
                        android:text="@string/campus_draw_undo"
                        android:textSize="@dimen/text_label" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDrawCancel"
                        style="@style/Widget.Unloop.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="@dimen/touch_min"
                        android:paddingHorizontal="@dimen/space_lg"
                        android:text="@string/campus_draw_cancel"
                        android:textColor="@color/campus_muted"
                        android:textSize="@dimen/text_label" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDrawDone"
                        style="@style/Widget.Unloop.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="@dimen/touch_min"
                        android:paddingHorizontal="@dimen/space_2xl"
                        android:text="@string/campus_draw_done"
                        android:textSize="@dimen/text_label"
                        app:backgroundTint="@color/campus_mint"
                        app:cornerRadius="@dimen/radius_card" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/textMapStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@drawable/bg_campus_chip"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_sm"
                android:textColor="@color/state_error"
                android:textSize="@dimen/text_caption"
                android:visibility="gone" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/runPlanPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_3xl"
            android:background="@drawable/bg_campus_card">
            <LinearLayout
                android:id="@+id/buttonGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:orientation="horizontal">
                <org.localroute.app.ui.RoutePreviewView
                    android:id="@+id/selectedRoutePreview"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/space_xl"
                    android:orientation="vertical">
                    <TextView
                    style="@style/Text.Unloop.Heading"
                        android:id="@+id/textRouteInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/campus_route_none"
                        android:textStyle="bold" />
                    <TextView
                    style="@style/Text.Unloop.Note"
                        android:id="@+id/textLapInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/run_choose_route"
                        />
                </LinearLayout>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_campus_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>
            <TextView
            style="@style/Text.Unloop.Note"
                android:id="@+id/textPlanSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_fm_metric"
                android:paddingHorizontal="@dimen/space_xl"
                android:paddingVertical="@dimen/space_sm"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRunSport"
                    style="@style/Widget.Unloop.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="72dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/campus_sport_run"
                    android:textSize="@dimen/text_meta" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/textPaceValue"
                    style="@style/Widget.Unloop.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textSize="@dimen/text_body"
                    android:minWidth="0dp"
                    android:paddingHorizontal="@dimen/space_md" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/textLaps"
                    style="@style/Widget.Unloop.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="52dp"
                    android:paddingHorizontal="@dimen/space_xs"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRunMain"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/run_start"
                    android:textSize="@dimen/text_title"
                    app:cornerRadius="@dimen/radius_card" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonEndRun"
                    style="@style/Widget.Unloop.TextButton"
                    android:layout_width="64dp"
                    android:layout_height="52dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="@dimen/space_xs"
                    android:text="@string/campus_end_run"
                    android:textColor="@color/campus_danger"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:id="@+id/setupScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/campus_setup_bg"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_4xl"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/buttonSetupBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/space_xl"
                    android:src="@drawable/ic_campus_back"
                    android:contentDescription="@string/run_return_map" />
                <TextView
                style="@style/Text.Unloop.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/run_settings"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/space_3xl"
                android:text="@string/run_settings_hint"
                android:textColor="@color/campus_muted"
                android:textSize="@dimen/text_body" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchNatural"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/campus_natural_title"
                android:textColor="@color/campus_ink"
                android:textSize="@dimen/text_title" />
            <TextView
            style="@style/Text.Unloop.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/campus_natural_hint"
                />
            <TextView
            style="@style/Text.Unloop.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5xl"
                android:text="@string/run_vary_next"
                android:textStyle="bold" />
            <TextView
            style="@style/Text.Unloop.Value"
                android:id="@+id/textVaryValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                />
            <TextView
            style="@style/Text.Unloop.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/campus_vary_hint"
                />
            <SeekBar
                android:id="@+id/seekVary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:max="100" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchCampusOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="@dimen/space_3xl"
                android:text="@string/campus_overlay_title"
                android:textColor="@color/campus_ink"
                android:textSize="@dimen/text_title" />
            <TextView
            style="@style/Text.Unloop.Meta"
                android:id="@+id/textCampusOverlayStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/rowAppSettings"
                style="@style/Widget.Unloop.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_5xl"
                android:text="@string/home_settings_subtitle" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_3xl"
                android:text="@string/run_return_map" />
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/doneOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/space_6xl"
            android:background="@drawable/bg_campus_card"
            android:elevation="@dimen/elevation_raised"
            android:orientation="vertical"
            android:padding="@dimen/space_5xl">
            <TextView
                android:id="@+id/textDoneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/campus_done_completed"
                android:textColor="@color/campus_ink"
                android:textSize="@dimen/text_hero"
                android:textStyle="bold" />
            <TextView
            style="@style/Text.Unloop.Note"
                android:id="@+id/textDoneMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3xl"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                    style="@style/Text.Unloop.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/campus_done_distance"
                        />
                    <TextView
                        android:id="@+id/textDoneDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/campus_ink"
                        android:textSize="@dimen/text_section"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                    style="@style/Text.Unloop.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/campus_done_time"
                        />
                    <TextView
                        android:id="@+id/textDoneTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/campus_ink"
                        android:textSize="@dimen/text_section"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                    style="@style/Text.Unloop.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/campus_done_avg_pace"
                        />
                    <TextView
                    style="@style/Text.Unloop.Section"
                        android:id="@+id/textDonePace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4xl"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonDoneBack"
                    style="@style/Widget.Unloop.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/run_return_map"
                    android:textSize="@dimen/text_meta"
                    app:cornerRadius="@dimen/radius_sheet" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonDoneAgain"
                    style="@style/Widget.Unloop.Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/campus_done_again"
                    android:textSize="@dimen/text_meta"
                    app:backgroundTint="@color/campus_mint"
                    app:cornerRadius="@dimen/radius_sheet" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
