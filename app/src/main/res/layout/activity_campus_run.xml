<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_setup_bg">
    <LinearLayout
        android:id="@+id/runScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="12dp"
            android:gravity="center_vertical">
            <ImageButton
                android:id="@+id/buttonRunBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_campus_back"
                android:padding="13dp"
                android:contentDescription="@string/campus_back" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/campus_title"
                android:textColor="@color/campus_ink"
                android:textSize="22sp"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/buttonAdvanced"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_campus_settings"
                android:padding="13dp"
                android:contentDescription="@string/run_settings" />
        </LinearLayout>
        <TextView
            android:id="@+id/textRunStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingBottom="10dp"
            android:text="@string/run_status_idle"
            android:textColor="@color/campus_mint_dark"
            android:textSize="13sp"
            android:accessibilityLiveRegion="polite" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:id="@+id/runStats">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/campus_stat_distance"
                    android:textColor="@color/campus_muted"
                    android:textSize="12sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="@color/campus_ink"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textDistanceUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="km"
                        android:textColor="@color/campus_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/campus_stat_time"
                    android:textColor="@color/campus_muted"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/textRunTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textColor="@color/campus_ink"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/campus_stat_pace"
                    android:textColor="@color/campus_muted"
                    android:textSize="12sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textPace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textPaceUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="/km"
                        android:textColor="@color/campus_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">
            <org.maplibre.android.maps.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <TextView
                android:id="@+id/textMapTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_campus_chip"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="@string/campus_map_tag"
                android:textColor="@color/campus_ink"
                android:textSize="10sp"
                app:drawableStartCompat="@drawable/ic_campus_dot" />
            <TextView
                android:id="@+id/textMapLayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="8dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/bg_campus_chip"
                android:clickable="true"
                android:contentDescription="@string/campus_map_layer_default_action"
                android:drawablePadding="5dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="@string/campus_map_layer_satellite"
                android:textColor="@color/campus_mint_dark"
                android:textSize="10sp"
                app:drawableStartCompat="@drawable/ic_campus_layers" />
            <TextView
                android:id="@+id/textCoordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_margin="8dp"
                android:background="@drawable/bg_campus_chip_dark"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="30.25610°N 119.72360°E"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/textMapMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_campus_chip"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="@string/campus_map_mode"
                android:textColor="@color/campus_muted"
                android:textSize="10sp"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/drawBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="46dp"
                android:background="@drawable/bg_campus_draw_bar"
                android:elevation="3dp"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/textDrawBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/campus_draw_banner"
                    android:textColor="@color/campus_ink"
                    android:textSize="12sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDrawUndo"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/campus_draw_undo"
                        android:textSize="12sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDrawCancel"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/campus_draw_cancel"
                        android:textColor="@color/campus_muted"
                        android:textSize="12sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDrawDone"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="@string/campus_draw_done"
                        android:textSize="12sp"
                        app:backgroundTint="@color/campus_mint"
                        app:cornerRadius="18dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/textMapStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_campus_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textColor="@color/state_error"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/runPlanPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_campus_card">
            <LinearLayout
                android:id="@+id/buttonGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:orientation="horizontal">
                <org.localroute.app.ui.RoutePreviewView
                    android:id="@+id/selectedRoutePreview"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/textRouteInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/campus_route_none"
                        android:textColor="@color/campus_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textLapInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/run_choose_route"
                        android:textColor="@color/campus_muted"
                        android:textSize="12sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_campus_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>
            <TextView
                android:id="@+id/textPlanSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_fm_metric"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/campus_muted"
                android:textSize="12sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRunSport"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="72dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/campus_sport_run"
                    android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/textPaceValue"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textSize="14sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/textLaps"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="52dp"
                    android:paddingHorizontal="4dp"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRunMain"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/run_start"
                    android:textSize="16sp"
                    app:cornerRadius="16dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonEndRun"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="64dp"
                    android:layout_height="52dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/campus_end_run"
                    android:textColor="@color/campus_danger"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:id="@+id/setupScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/campus_setup_bg"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/buttonSetupBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="13dp"
                    android:src="@drawable/ic_campus_back"
                    android:contentDescription="@string/run_return_map" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/run_settings"
                    android:textColor="@color/campus_ink"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                android:text="@string/run_settings_hint"
                android:textColor="@color/campus_muted"
                android:textSize="14sp" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchNatural"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/campus_natural_title"
                android:textColor="@color/campus_ink"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/campus_natural_hint"
                android:textColor="@color/campus_muted"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/run_vary_next"
                android:textColor="@color/campus_ink"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/textVaryValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/campus_mint_dark"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/campus_vary_hint"
                android:textColor="@color/campus_muted"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/seekVary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:max="100" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchCampusOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/campus_overlay_title"
                android:textColor="@color/campus_ink"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/textCampusOverlayStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/campus_muted"
                android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/rowAppSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="@string/home_settings_subtitle" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/run_return_map" />
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/doneOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="30dp"
            android:background="@drawable/bg_campus_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:id="@+id/textDoneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/campus_done_completed"
                android:textColor="@color/campus_ink"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/textDoneMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/campus_muted"
                android:textSize="12sp"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/campus_done_distance"
                        android:textColor="@color/campus_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/textDoneDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/campus_ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/campus_done_time"
                        android:textColor="@color/campus_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/textDoneTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/campus_ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/campus_done_avg_pace"
                        android:textColor="@color/campus_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/textDonePace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonDoneBack"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/run_return_map"
                    android:textSize="13sp"
                    app:cornerRadius="22dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonDoneAgain"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/campus_done_again"
                    android:textSize="13sp"
                    app:backgroundTint="@color/campus_mint"
                    app:cornerRadius="22dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
