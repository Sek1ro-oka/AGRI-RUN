<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:minHeight="?attr/actionBarSize"
        app:title="@string/diagnostics_title" />
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchCoordinates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_3xl"
        android:paddingVertical="@dimen/space_md"
        android:text="@string/diagnostics_coordinate_log" />
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchGmsFlp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/gms_flp_toggle"
        android:textSize="@dimen/text_body" />
    <TextView
        android:id="@+id/textGmsFlp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/gms_flp_idle"
        android:textSize="@dimen/text_label" />
    <TextView
        android:id="@+id/textSelfCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/study_state_pending_fill"
        android:textColor="@color/fm_warning"
        android:paddingHorizontal="@dimen/space_3xl"
        android:paddingVertical="@dimen/space_lg"
        android:text="@string/self_check_idle"
        android:textIsSelectable="true"
        android:textSize="@dimen/text_label" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/space_3xl">
        <TextView
            android:id="@+id/textReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingVertical="@dimen/space_md"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_label" />
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCopy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/diagnostics_copy"
            android:textSize="@dimen/text_meta" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClearLog"
            style="@style/Widget.Unloop.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/diagnostics_clear_log"
            android:textSize="@dimen/text_meta" />
    </LinearLayout>
</LinearLayout>
