<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fm_surface">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/fm_surface"
        app:title="@string/fm_functions"
        app:titleTextColor="@color/fm_text" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_4xl"
            android:paddingBottom="@dimen/space_3xl">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHomeBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                app:cardBackgroundColor="@color/fm_surface_alt"
                app:cardCornerRadius="@dimen/radius_sheet"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <ImageView
                    android:id="@+id/imageHomeBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/run_card_backdrop" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveRun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                app:cardBackgroundColor="@color/fm_surface_alt"
                app:cardCornerRadius="@dimen/radius_sheet"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_3xl">
                    <TextView
                        android:id="@+id/textActiveRunTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/fm_text"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textActiveRunDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textColor="@color/fm_link"
                        android:textSize="@dimen/text_meta" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- 环境没准备好时才出现；三项阻塞项就绪后自动收起，不占常驻位置。 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSetupGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                app:cardBackgroundColor="@color/fm_surface_alt"
                app:cardCornerRadius="@dimen/radius_sheet"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_3xl">
                    <ImageView
                        android:layout_width="@dimen/icon_home"
                        android:layout_height="@dimen/icon_home"
                        android:background="@drawable/bg_campus_entry_icon"
                        android:contentDescription="@null"
                        android:padding="@dimen/space_sm"
                        android:src="@drawable/ic_campus_settings"
                        app:tint="@color/fm_link" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xl"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/textSetupGuideTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/fm_text"
                            android:textSize="@dimen/text_lead"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/textSetupGuideDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textColor="@color/fm_text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3xl"
                android:layout_marginBottom="@dimen/space_xl"
                android:text="@string/fm_home_section"
                android:textColor="@color/fm_text_secondary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCampusRun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/fm_surface_alt"
                    app:cardCornerRadius="@dimen/radius_sheet"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_2xl">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="@dimen/icon_home"
                                android:layout_height="@dimen/icon_home"
                                android:background="@drawable/bg_campus_entry_icon"
                                android:contentDescription="@null"
                                android:padding="@dimen/space_sm"
                                android:src="@drawable/ic_campus_run"
                                app:tint="@color/fm_link" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:text="@string/campus_entry_title"
                                android:textColor="@color/fm_text"
                                android:textSize="@dimen/text_lead"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/campus_entry_subtitle_short"
                            android:textColor="@color/fm_text_secondary"
                            android:textSize="@dimen/text_caption" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/fm_run_action"
                            android:textColor="@color/fm_link"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVirtualLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xl"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/fm_surface_alt"
                    app:cardCornerRadius="@dimen/radius_sheet"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_2xl">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="@dimen/icon_home"
                                android:layout_height="@dimen/icon_home"
                                android:background="@drawable/bg_campus_entry_icon"
                                android:contentDescription="@null"
                                android:padding="@dimen/space_sm"
                                android:src="@drawable/ic_campus_teleport"
                                app:tint="@color/fm_link" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:text="@string/virtual_title"
                                android:textColor="@color/fm_text"
                                android:textSize="@dimen/text_lead"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/virtual_entry_subtitle"
                            android:textColor="@color/fm_text_secondary"
                            android:textSize="@dimen/text_caption" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/virtual_entry_action"
                            android:textColor="@color/fm_link"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3xl"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/fm_study_short"
                android:textColor="@color/fm_text_secondary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/cardTimetable"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="@dimen/space_lg"
                    android:background="@drawable/bg_campus_entry_icon"
                    android:src="@drawable/ic_study_calendar"
                    android:contentDescription="@null"
                    app:tint="@color/fm_link" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_xl"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fm_timetable"
                        android:textColor="@color/fm_text"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_hair"
                        android:text="@string/fm_timetable_description"
                        android:textColor="@color/fm_muted"
                        android:textSize="@dimen/text_label" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_campus_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/inset_nav"
                android:background="@color/fm_border" />
            <LinearLayout
                android:id="@+id/cardStudy"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="@dimen/space_lg"
                    android:background="@drawable/bg_campus_entry_icon"
                    android:src="@drawable/ic_study_homework"
                    android:contentDescription="@null"
                    app:tint="@color/fm_link" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_xl"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/study_title"
                        android:textColor="@color/fm_text"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_hair"
                        android:text="@string/study_entry_subtitle_short"
                        android:textColor="@color/fm_muted"
                        android:textSize="@dimen/text_label" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_campus_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav" />
</LinearLayout>