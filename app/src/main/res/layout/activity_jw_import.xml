<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_setup_bg"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_4xl"
        android:paddingTop="@dimen/space_md">
        <ImageButton
            android:id="@+id/buttonJwBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_campus_soft_circle"
            android:contentDescription="@string/study_back"
            android:elevation="@dimen/elevation_low"
            android:padding="@dimen/space_xl"
            android:src="@drawable/ic_campus_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_weight="1"
            android:text="@string/study_jw_title"
            android:textColor="@color/campus_ink"
            android:textSize="@dimen/text_page_title"
            android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonJwRelogin"
            style="@style/Widget.Unloop.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="@dimen/touch_min"
            android:paddingHorizontal="@dimen/space_lg"
            android:text="@string/study_jw_relogin"
            android:textColor="@color/campus_mint_dark"
            android:textSize="@dimen/text_meta"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rowJwSchool"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_4xl"
        android:layout_marginTop="@dimen/space_sm"
        android:background="@drawable/bg_campus_soft_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_2xl"
        android:paddingVertical="@dimen/space_md">
        <TextView
            android:id="@+id/textJwSchool"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/study_jw_school_none"
            android:textColor="@color/campus_ink"
            android:textSize="@dimen/text_label"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:text="@string/study_jw_school_change"
            android:textColor="@color/campus_mint_dark"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_4xl"
        android:layout_marginTop="@dimen/space_sm"
        android:background="@drawable/bg_campus_soft_pill"
        android:lineSpacingExtra="2dp"
        android:paddingHorizontal="@dimen/space_2xl"
        android:paddingVertical="@dimen/space_md"
        android:text="@string/study_jw_hint"
        android:textColor="@color/campus_mint_dark"
        android:textSize="@dimen/text_caption" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_weight="1">
        <WebView
            android:id="@+id/jwWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <LinearLayout
            android:id="@+id/jwLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/campus_setup_bg"
            android:gravity="center"
            android:orientation="vertical">
            <ProgressBar
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:indeterminateTint="@color/campus_mint" />
            <TextView
            style="@style/Text.Unloop.Note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/study_jw_loading"
                />
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:id="@+id/textJwStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_4xl"
        android:layout_marginTop="@dimen/space_sm"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/campus_danger"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_4xl"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xl">
        <ProgressBar
            android:id="@+id/progressJw"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="@dimen/space_lg"
            android:indeterminateTint="@color/campus_mint"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonJwFetch"
            style="@style/Widget.Unloop.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="@dimen/touch_min"
            android:text="@string/study_jw_fetch"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            app:cornerRadius="@dimen/radius_card" />
    </LinearLayout>
</LinearLayout>
