<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fm_background">
    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- 纯色页头：无插画，问候语直接落在页面背景上。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_4xl"
                android:paddingTop="@dimen/space_4xl"
                android:paddingBottom="@dimen/space_lg">
                <TextView
                    android:id="@+id/textHomeGreeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fm_text"
                    android:textSize="@dimen/text_hero"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/textHomeGreetingSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_hair"
                    android:textColor="@color/fm_text_secondary"
                    android:textSize="@dimen/text_label"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_4xl"
                android:paddingBottom="@dimen/space_md">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHomeAgenda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    app:cardBackgroundColor="@color/fm_surface"
                    app:cardCornerRadius="@dimen/radius_sheet"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_3xl">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/textHomeDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/fm_text"
                                android:textSize="@dimen/text_title"
                                android:textStyle="bold" />
                            <ImageView
                                android:id="@+id/buttonHomeCalendar"
                                android:layout_width="@dimen/touch_min"
                                android:layout_height="@dimen/touch_min"
                                android:background="@drawable/bg_campus_entry_icon"
                                android:padding="@dimen/space_xl"
                                android:clickable="true"
                                android:focusable="true"
                                android:src="@drawable/ic_study_calendar"
                                android:contentDescription="@string/fm_timetable"
                                app:tint="@color/fm_link" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/weekStrip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:orientation="horizontal" />
                        <LinearLayout
                            android:id="@+id/agendaList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:orientation="vertical" />
                        <LinearLayout
                            android:id="@+id/agendaEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">
                            <TextView
                                android:id="@+id/textHomeEmptyTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/fm_text"
                                android:textSize="@dimen/text_meta"
                                android:maxLines="1"
                                android:ellipsize="end" />
                            <TextView
                                android:id="@+id/buttonHomeImport"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:minHeight="@dimen/touch_min"
                                android:gravity="center"
                                android:background="@drawable/bg_home_pill"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="@dimen/space_xl"
                                android:paddingVertical="@dimen/space_sm"
                                android:text="@string/home_agenda_import_action"
                                android:textColor="@color/fm_on_brand"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/textHomeAgendaCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textColor="@color/fm_text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHomework"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    app:cardBackgroundColor="@color/fm_surface"
                    app:cardCornerRadius="@dimen/radius_sheet"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_3xl">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_homework_section"
                            android:textColor="@color/fm_text"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />
                        <LinearLayout
                            android:id="@+id/homeworkList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:orientation="vertical" />
                        <LinearLayout
                            android:id="@+id/homeworkEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">
                            <TextView
                                android:id="@+id/textHomeworkEmpty"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/fm_text"
                                android:textSize="@dimen/text_meta"
                                android:maxLines="1"
                                android:ellipsize="end" />
                            <TextView
                                android:id="@+id/buttonHomeworkEmpty"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:minHeight="@dimen/touch_min"
                                android:gravity="center"
                                android:background="@drawable/bg_home_pill"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="@dimen/space_xl"
                                android:paddingVertical="@dimen/space_sm"
                                android:text="@string/home_homework_view_action"
                                android:textColor="@color/fm_on_brand"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/textHomeworkFoot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textColor="@color/fm_text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav" />
</LinearLayout>
