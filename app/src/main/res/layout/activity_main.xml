<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fm_surface">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- 插画通栏，问候语压在下缘；scrim 保证文字对比度，随时段换图与换字色。 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="160dp">
                <ImageView
                    android:id="@+id/imageHomeHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/home_hero_description"
                    android:src="@drawable/home_hero_night" />
                <View
                    android:id="@+id/viewHomeScrim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_home_hero_scrim_dark" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_4xl"
                    android:paddingBottom="@dimen/space_lg">
                    <TextView
                        android:id="@+id/textHomeGreeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/fm_hero_on_dark"
                        android:textSize="@dimen/text_hero"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/textHomeGreetingSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_hair"
                        android:textColor="@color/fm_hero_on_dark_sub"
                        android:textSize="@dimen/text_label"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_4xl"
                android:paddingBottom="@dimen/space_3xl">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHomeAgenda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    app:cardBackgroundColor="@color/fm_surface_alt"
                    app:cardCornerRadius="@dimen/radius_sheet"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_2xl">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/textHomeDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/fm_text"
                                android:textSize="@dimen/text_title"
                                android:textStyle="bold" />
                            <ImageView
                                android:id="@+id/buttonHomeCalendar"
                                android:layout_width="@dimen/icon_home"
                                android:layout_height="@dimen/icon_home"
                                android:background="@drawable/bg_campus_entry_icon"
                                android:padding="@dimen/space_sm"
                                android:clickable="true"
                                android:focusable="true"
                                android:src="@drawable/ic_study_calendar"
                                android:contentDescription="@string/fm_timetable"
                                app:tint="@color/fm_link" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/weekStrip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:orientation="horizontal" />
                        <LinearLayout
                            android:id="@+id/agendaList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_lg"
                            android:orientation="vertical" />
                        <LinearLayout
                            android:id="@+id/agendaEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_lg"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:visibility="gone">
                            <TextView
                                android:id="@+id/textHomeEmptyTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textColor="@color/fm_text"
                                android:textSize="@dimen/text_lead"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/textHomeEmptyDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:gravity="center"
                                android:textColor="@color/fm_muted"
                                android:textSize="@dimen/text_caption" />
                            <TextView
                                android:id="@+id/buttonHomeBind"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_lg"
                                android:background="@drawable/bg_home_pill"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="@dimen/space_5xl"
                                android:paddingVertical="@dimen/space_md"
                                android:text="@string/home_bind_action"
                                android:textColor="@color/fm_surface"
                                android:textSize="@dimen/text_label"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <View
                            android:id="@+id/dividerAgendaCount"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/space_md"
                            android:background="@color/fm_border" />
                        <TextView
                            android:id="@+id/textHomeAgendaCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:textColor="@color/fm_text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3xl"
                    android:layout_marginBottom="@dimen/space_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_account_section"
                        android:textColor="@color/fm_text_secondary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_account_placeholder"
                        android:textColor="@color/fm_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:id="@+id/cardHomeTraffic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_account_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="@dimen/space_xl">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_home_traffic"
                                android:contentDescription="@null"
                                app:tint="@color/fm_link" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_sm"
                                android:layout_weight="1"
                                android:text="@string/home_account_traffic"
                                android:textColor="@color/fm_text_secondary"
                                android:textSize="@dimen/text_caption"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:gravity="bottom"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_account_value_unknown"
                                android:textColor="@color/fm_nav_idle"
                                android:textSize="@dimen/text_metric"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_xs"
                                android:layout_marginBottom="@dimen/space_xs"
                                android:text="@string/home_account_unit_gb"
                                android:textColor="@color/fm_nav_idle"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_hair"
                            android:text="@string/home_account_missing"
                            android:textColor="@color/fm_muted"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/cardHomePower"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_account_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="@dimen/space_xl">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_home_power"
                                android:contentDescription="@null"
                                app:tint="@color/fm_link" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_sm"
                                android:layout_weight="1"
                                android:text="@string/home_account_power"
                                android:textColor="@color/fm_text_secondary"
                                android:textSize="@dimen/text_caption"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:gravity="bottom"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_account_value_unknown"
                                android:textColor="@color/fm_nav_idle"
                                android:textSize="@dimen/text_metric"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_xs"
                                android:layout_marginBottom="@dimen/space_xs"
                                android:text="@string/home_account_unit_kwh"
                                android:textColor="@color/fm_nav_idle"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_hair"
                            android:text="@string/home_account_missing"
                            android:textColor="@color/fm_muted"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:id="@+id/cardHomeCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_account_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="@dimen/space_xl">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_home_card"
                                android:contentDescription="@null"
                                app:tint="@color/fm_link" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_sm"
                                android:layout_weight="1"
                                android:text="@string/home_account_card"
                                android:textColor="@color/fm_text_secondary"
                                android:textSize="@dimen/text_caption"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:gravity="bottom"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_account_value_unknown"
                                android:textColor="@color/fm_nav_idle"
                                android:textSize="@dimen/text_metric"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_xs"
                                android:layout_marginBottom="@dimen/space_xs"
                                android:text="@string/home_account_unit_yuan"
                                android:textColor="@color/fm_nav_idle"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_hair"
                            android:text="@string/home_account_missing"
                            android:textColor="@color/fm_muted"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/cardHomeSpend"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_account_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="@dimen/space_xl">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_home_spend"
                                android:contentDescription="@null"
                                app:tint="@color/fm_link" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_sm"
                                android:layout_weight="1"
                                android:text="@string/home_account_spend"
                                android:textColor="@color/fm_text_secondary"
                                android:textSize="@dimen/text_caption"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:gravity="bottom"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_account_value_unknown"
                                android:textColor="@color/fm_nav_idle"
                                android:textSize="@dimen/text_metric"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_xs"
                                android:layout_marginBottom="@dimen/space_xs"
                                android:text="@string/home_account_unit_yuan"
                                android:textColor="@color/fm_nav_idle"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_hair"
                            android:text="@string/home_account_missing"
                            android:textColor="@color/fm_muted"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav" />
</LinearLayout>