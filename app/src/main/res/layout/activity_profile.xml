<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fm_surface">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/fm_surface"
        app:title="@string/fm_profile"
        app:titleTextColor="@color/fm_text" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_4xl"
            android:paddingBottom="@dimen/space_3xl">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/study_account_title"
                android:textColor="@color/fm_text_secondary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fm_surface_alt"
                app:cardCornerRadius="@dimen/radius_sheet"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_3xl">
                    <TextView
                        android:id="@+id/textProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/fm_text"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textProfileMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textColor="@color/fm_text_secondary"
                        android:textSize="@dimen/text_caption" />
                    <TextView
                        android:id="@+id/buttonProfileAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xl"
                        android:background="@drawable/bg_home_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="@dimen/space_5xl"
                        android:paddingVertical="@dimen/space_md"
                        android:text="@string/study_account_bind"
                        android:textColor="@color/fm_surface"
                        android:textSize="@dimen/text_label"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3xl"
                android:text="@string/profile_pending_section"
                android:textColor="@color/fm_text_secondary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/profile_pending_hint"
                android:textColor="@color/fm_muted"
                android:textSize="@dimen/text_caption" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_account_card"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_xl">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="@dimen/icon_home"
                        android:layout_height="@dimen/icon_home"
                        android:background="@drawable/bg_campus_entry_icon"
                        android:padding="@dimen/space_sm"
                        android:src="@drawable/ic_home_traffic"
                        android:contentDescription="@null"
                        app:tint="@color/fm_link" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xl"
                        android:layout_weight="1"
                        android:text="@string/profile_pending_traffic"
                        android:textColor="@color/fm_text"
                        android:textSize="@dimen/text_meta" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_tag_outline"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:paddingVertical="1dp"
                        android:text="@string/profile_pending_status"
                        android:textColor="@color/fm_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/inset_nav"
                    android:background="@color/fm_border" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="@dimen/icon_home"
                        android:layout_height="@dimen/icon_home"
                        android:background="@drawable/bg_campus_entry_icon"
                        android:padding="@dimen/space_sm"
                        android:src="@drawable/ic_home_power"
                        android:contentDescription="@null"
                        app:tint="@color/fm_link" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xl"
                        android:layout_weight="1"
                        android:text="@string/profile_pending_power"
                        android:textColor="@color/fm_text"
                        android:textSize="@dimen/text_meta" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_tag_outline"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:paddingVertical="1dp"
                        android:text="@string/profile_pending_status"
                        android:textColor="@color/fm_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/inset_nav"
                    android:background="@color/fm_border" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="@dimen/icon_home"
                        android:layout_height="@dimen/icon_home"
                        android:background="@drawable/bg_campus_entry_icon"
                        android:padding="@dimen/space_sm"
                        android:src="@drawable/ic_home_card"
                        android:contentDescription="@null"
                        app:tint="@color/fm_link" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xl"
                        android:layout_weight="1"
                        android:text="@string/profile_pending_card"
                        android:textColor="@color/fm_text"
                        android:textSize="@dimen/text_meta" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_tag_outline"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:paddingVertical="1dp"
                        android:text="@string/profile_pending_status"
                        android:textColor="@color/fm_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/inset_nav"
                    android:background="@color/fm_border" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="@dimen/icon_home"
                        android:layout_height="@dimen/icon_home"
                        android:background="@drawable/bg_campus_entry_icon"
                        android:padding="@dimen/space_sm"
                        android:src="@drawable/ic_campus_bookmark"
                        android:contentDescription="@null"
                        app:tint="@color/fm_link" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xl"
                        android:layout_weight="1"
                        android:text="@string/profile_pending_library"
                        android:textColor="@color/fm_text"
                        android:textSize="@dimen/text_meta" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_tag_outline"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:paddingVertical="1dp"
                        android:text="@string/profile_pending_status"
                        android:textColor="@color/fm_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav" />
</LinearLayout>