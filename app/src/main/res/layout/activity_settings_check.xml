<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fm_surface"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fm_surface"
        android:minHeight="?attr/actionBarSize"
        app:title="@string/settings_title"
        app:titleTextColor="@color/campus_ink" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_md">
            <TextView
                style="@style/Text.Unloop.Note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3xl"
                android:layout_marginTop="@dimen/space_3xl"
                android:letterSpacing="0.08"
                android:text="@string/settings_section_presets"
                android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xl"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_xl"
                app:cardBackgroundColor="@color/fm_surface"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/fm_border"
                app:strokeWidth="@dimen/stroke_edge">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_3xl">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.Unloop.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_conflict_ask_title"
                            android:textStyle="bold" />
                        <TextView
                            style="@style/Text.Unloop.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/settings_conflict_ask_summary" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPresetConflictAsk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xl" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/Text.Unloop.Note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3xl"
                android:layout_marginTop="@dimen/space_3xl"
                android:letterSpacing="0.08"
                android:text="@string/settings_section_environment"
                android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xl"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_xl"
                app:cardBackgroundColor="@color/fm_surface"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/fm_border"
                app:strokeWidth="@dimen/stroke_edge">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_2xl">
                    <TextView
                        style="@style/Text.Unloop.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/settings_intro" />
                    <TextView
                        android:id="@+id/textGuideNext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="@dimen/text_label"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:id="@+id/checkContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/Text.Unloop.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_3xl"
                android:layout_marginTop="@dimen/space_lg"
                android:lineSpacingExtra="2dp"
                android:text="@string/settings_probe_hint" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fm_surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_md">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRecheck"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/settings_recheck"
                android:textColor="@color/brand_on_primary"
                android:textSize="@dimen/text_meta"
                app:backgroundTint="@color/campus_mint_dark"
                app:cornerRadius="@dimen/radius_control" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonProbe"
                style="@style/Widget.Unloop.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/settings_probe_mock"
                android:textColor="@color/campus_mint_dark"
                android:textSize="@dimen/text_meta"
                app:cornerRadius="@dimen/radius_control"
                app:strokeColor="@color/campus_mint_dark" />
        </LinearLayout>
        <!-- 悬浮窗与开发者选项的跳转已经并进对应检查行的按钮里，这里只留全局动作。 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAppDetails"
            style="@style/Widget.Unloop.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_hair"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/settings_open_app_details"
            android:textColor="@color/campus_mint_dark"
            android:textSize="@dimen/text_label" />
    </LinearLayout>
</LinearLayout>
