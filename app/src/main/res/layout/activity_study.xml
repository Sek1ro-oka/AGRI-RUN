<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_setup_bg"
    android:orientation="vertical">

    <!-- 顶部：标题 + 当前学习通账户 + 右上角设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/buttonStudyBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_campus_soft_circle"
            android:contentDescription="@string/study_back"
            android:elevation="2dp"
            android:padding="11dp"
            android:src="@drawable/ic_campus_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/study_title"
                android:textColor="@color/campus_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textStudyAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/study_account_unbound"
                android:textColor="@color/campus_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/buttonStudySettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_campus_soft_circle"
            android:contentDescription="@string/study_settings_title"
            android:elevation="2dp"
            android:padding="11dp"
            android:src="@drawable/ic_campus_settings" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ==================== 作业页 ==================== -->
        <LinearLayout
            android:id="@+id/homeworkScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    android:id="@+id/textHomeworkSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/study_homework_summary_loading"
                    android:textColor="@color/campus_muted"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/buttonHomeworkRefresh"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_campus_soft_circle"
                    android:contentDescription="@string/study_homework_retry"
                    android:padding="9dp"
                    android:src="@drawable/ic_study_refresh" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ScrollView
                    android:id="@+id/homeworkScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:descendantFocusability="blocksDescendants"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/homeworkList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="20dp" />
                </ScrollView>

                <LinearLayout
                    android:id="@+id/stateHomeworkEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="40dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_campus_entry_icon"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        android:src="@drawable/ic_study_homework" />

                    <TextView
                        android:id="@+id/textHomeworkEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/study_homework_empty_title"
                        android:textColor="@color/campus_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textHomeworkEmptyHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/study_homework_empty_hint"
                        android:textColor="@color/campus_muted"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonHomeworkEmptyAction"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/study_homework_retry"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stateHomeworkLoading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:indeterminateTint="@color/campus_mint" />

                    <TextView
                        android:id="@+id/textHomeworkLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/study_homework_summary_loading"
                        android:textColor="@color/campus_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ==================== 课表页 ==================== -->
        <ScrollView
            android:id="@+id/timetableScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="blocksDescendants"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/textTimetableSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/campus_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonImportTimetable"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="@string/study_timetable_import"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_study_import"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/campus_mint_dark"
                        app:strokeColor="@color/campus_card_stroke" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAddCourse"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="@string/study_timetable_add"
                        android:textColor="@color/brand_on_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/campus_mint"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_study_add"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/brand_on_primary" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/scrollTimetable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_campus_card"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <org.localroute.app.ui.TimetableGridView
                        android:id="@+id/timetableGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/textTimetableEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_campus_card"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="28dp"
                    android:text="@string/study_timetable_empty"
                    android:textColor="@color/campus_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textTimetableNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/campus_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 底部切换：作业 / 课表 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/campus_card_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:id="@+id/tabHomework"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_study_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconTabHomework"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_study_homework" />

            <TextView
                android:id="@+id/textTabHomework"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/study_tab_homework"
                android:textColor="@color/campus_mint_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/tabTimetable"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_study_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconTabTimetable"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_study_calendar" />

            <TextView
                android:id="@+id/textTabTimetable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/study_tab_timetable"
                android:textColor="@color/campus_muted"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
