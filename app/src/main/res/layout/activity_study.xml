<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_setup_bg"
    android:orientation="vertical">
    <!-- 顶部：标题 + 当前学习通账户 + 右上角设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_4xl"
        android:paddingTop="@dimen/space_md">
        <ImageButton
            android:id="@+id/buttonStudyBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_campus_soft_circle"
            android:contentDescription="@string/study_back"
            android:elevation="@dimen/elevation_low"
            android:padding="@dimen/space_xl"
            android:src="@drawable/ic_campus_back" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/Text.Unloop.Metric"
                android:id="@+id/textStudyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/study_title"
                android:textStyle="bold" />
            <TextView
                style="@style/Text.Unloop.Note"
                android:id="@+id/textStudyAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_hair"
                android:text="@string/study_account_unbound" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/buttonStudySettings"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_campus_soft_circle"
            android:contentDescription="@string/study_settings_title"
            android:elevation="@dimen/elevation_low"
            android:padding="@dimen/space_xl"
            android:src="@drawable/ic_campus_settings" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <!-- ==================== 作业页 ==================== -->
        <LinearLayout
            android:id="@+id/homeworkScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_4xl">
                <TextView
                    style="@style/Text.Unloop.Note"
                    android:id="@+id/textHomeworkSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/study_homework_summary_loading" />
                <ImageButton
                    android:id="@+id/buttonHomeworkRefresh"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_campus_soft_circle"
                    android:contentDescription="@string/study_homework_retry"
                    android:padding="@dimen/space_md"
                    android:src="@drawable/ic_study_refresh" />
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ScrollView
                    android:id="@+id/homeworkScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:descendantFocusability="blocksDescendants"
                    android:fillViewport="true"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/homeworkList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_4xl"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_4xl" />
                </ScrollView>
                <LinearLayout
                    android:id="@+id/stateHomeworkEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_7xl"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_campus_entry_icon"
                        android:contentDescription="@null"
                        android:padding="@dimen/space_2xl"
                        android:src="@drawable/ic_study_homework" />
                    <TextView
                        style="@style/Text.Unloop.Heading"
                        android:id="@+id/textHomeworkEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xl"
                        android:text="@string/study_homework_empty_title"
                        android:textStyle="bold" />
                    <TextView
                        style="@style/Text.Unloop.Note"
                        android:id="@+id/textHomeworkEmptyHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center"
                        android:text="@string/study_homework_empty_hint" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonHomeworkEmptyAction"
                        style="@style/Widget.Unloop.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/study_homework_retry"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="@dimen/text_meta"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/stateHomeworkLoading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ProgressBar
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:indeterminateTint="@color/campus_mint" />
                    <TextView
                        style="@style/Text.Unloop.Note"
                        android:id="@+id/textHomeworkLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/study_homework_summary_loading" />
                </LinearLayout>
            </FrameLayout>
            <!-- 底部固定入口：自建作业只在本机保存，用于「作业截止提醒」 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_4xl"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xl">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonAddHomework"
                    style="@style/Widget.Unloop.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="@dimen/space_xs"
                    android:singleLine="true"
                    android:text="@string/study_homework_add"
                    android:textColor="@color/campus_mint_dark"
                    android:textSize="@dimen/text_meta"
                    android:textStyle="bold"
                    app:backgroundTint="@color/campus_mint_pale"
                    app:cornerRadius="@dimen/radius_card"
                    app:icon="@drawable/ic_study_add"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/campus_mint_dark" />
            </LinearLayout>
        </LinearLayout>
        <!-- ==================== 课表页 ==================== -->
        <ScrollView
            android:id="@+id/timetableScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="blocksDescendants"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_4xl"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_5xl">
                <TextView
                    style="@style/Text.Unloop.Note"
                    android:id="@+id/textTimetableSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <LinearLayout
                    android:id="@+id/bannerSemesterStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_campus_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_2xl"
                    android:paddingVertical="@dimen/space_lg"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_study_calendar" />
                    <TextView
                        style="@style/Text.Unloop.Note"
                        android:id="@+id/textBannerSemesterStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1" />
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_campus_chevron_right" />
                </LinearLayout>
                <!-- 教学周次：按周查看，默认显示本学期当前周，可左右滑动 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/bg_campus_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="@dimen/space_md">
                    <ImageButton
                        android:id="@+id/buttonPrevWeek"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:background="@drawable/bg_campus_soft_circle"
                        android:contentDescription="@string/study_week_prev"
                        android:padding="@dimen/space_lg"
                        android:rotation="180"
                        android:src="@drawable/ic_campus_chevron_right" />
                    <LinearLayout
                        android:id="@+id/weekPicker"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_hair">
                        <TextView
                            style="@style/Text.Unloop.Heading"
                            android:id="@+id/textWeekLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/study_week_first"
                            android:textStyle="bold" />
                        <TextView
                            style="@style/Text.Unloop.Caption"
                            android:id="@+id/textWeekRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_hair"
                            android:text="@string/study_week_total_default" />
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/buttonNextWeek"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:background="@drawable/bg_campus_soft_circle"
                        android:contentDescription="@string/study_week_next"
                        android:padding="@dimen/space_lg"
                        android:src="@drawable/ic_campus_chevron_right" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonImportTimetable"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:singleLine="true"
                        style="@style/Widget.Unloop.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="@string/study_timetable_import"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="@dimen/text_meta"
                        android:textStyle="bold"
                        app:backgroundTint="@color/campus_mint_pale"
                        app:cornerRadius="@dimen/radius_card"
                        app:icon="@drawable/ic_study_import"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/campus_mint_dark" />
                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAddCourse"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:singleLine="true"
                        style="@style/Widget.Unloop.Button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="@string/study_timetable_add"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="@dimen/text_meta"
                        android:textStyle="bold"
                        app:backgroundTint="@color/campus_mint_pale"
                        app:cornerRadius="@dimen/radius_card"
                        app:icon="@drawable/ic_study_add"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/campus_mint_dark" />
                </LinearLayout>
                <org.localroute.app.ui.TimetableGridView
                    android:id="@+id/timetableGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xl"
                    android:background="@drawable/bg_campus_card"
                    android:padding="@dimen/space_sm" />
                <TextView
                    style="@style/Text.Unloop.Meta"
                    android:id="@+id/textTimetableEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xl"
                    android:background="@drawable/bg_campus_card"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_5xl"
                    android:paddingVertical="@dimen/space_5xl"
                    android:text="@string/study_timetable_empty"
                    android:visibility="gone" />
                <TextView
                    style="@style/Text.Unloop.Caption"
                    android:id="@+id/textTimetableNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <!-- 底部切换：作业 / 课表 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/campus_card_stroke" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="@dimen/space_4xl"
        android:layout_marginBottom="@dimen/space_lg"
        android:background="@drawable/bg_fm_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_4xl">
        <LinearLayout
            android:id="@+id/tabHomework"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_weight="1"
            android:background="@drawable/bg_study_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/iconTabHomework"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_study_homework" />
            <TextView
                style="@style/Text.Unloop.Action"
                android:id="@+id/textTabHomework"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/study_tab_homework"
                android:textStyle="bold" />
        </LinearLayout>
        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:id="@+id/tabTimetable"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_weight="1"
            android:background="@drawable/bg_study_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/iconTabTimetable"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_study_calendar" />
            <TextView
                style="@style/Text.Unloop.Meta"
                android:id="@+id/textTabTimetable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/study_tab_timetable"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
