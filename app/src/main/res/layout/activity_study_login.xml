<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fm_surface"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_4xl"
        android:paddingTop="@dimen/space_md">
        <ImageButton
            android:id="@+id/buttonLoginBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_campus_soft_circle"
            android:contentDescription="@string/study_back"
            android:elevation="@dimen/elevation_low"
            android:padding="@dimen/space_xl"
            android:src="@drawable/ic_campus_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_weight="1"
            android:text="@string/study_login_title"
            android:textColor="@color/campus_ink"
            android:textSize="@dimen/text_page_title"
            android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLoginFinish"
            style="@style/Widget.Unloop.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="@dimen/touch_min"
            android:paddingHorizontal="@dimen/space_lg"
            android:text="@string/study_login_finish"
            android:textColor="@color/campus_mint_dark"
            android:textSize="@dimen/text_meta"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_4xl"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_campus_soft_pill"
        android:lineSpacingExtra="2dp"
        android:paddingHorizontal="@dimen/space_2xl"
        android:paddingVertical="@dimen/space_md"
        android:text="@string/study_login_hint"
        android:textColor="@color/campus_mint_dark"
        android:textSize="@dimen/text_caption" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_weight="1">
        <WebView
            android:id="@+id/loginWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <LinearLayout
            android:id="@+id/loginLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/fm_surface"
            android:gravity="center"
            android:orientation="vertical">
            <ProgressBar
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:indeterminateTint="@color/campus_mint" />
            <TextView
            style="@style/Text.Unloop.Note"
                android:id="@+id/textLoginLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/study_login_loading"
                />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
