<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_setup_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/buttonSettingsBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_campus_soft_circle"
            android:contentDescription="@string/study_back"
            android:elevation="2dp"
            android:padding="11dp"
            android:src="@drawable/ic_campus_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/study_settings_title"
            android:textColor="@color/campus_ink"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="26dp">

            <!-- 学习通账户 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_campus_card"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/study_account_title"
                    android:textColor="@color/campus_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textAccountName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/study_account_unbound"
                    android:textColor="@color/campus_ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textAccountMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/study_account_unbound_hint"
                    android:textColor="@color/campus_muted"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSwitchAccount"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/study_account_switch"
                    android:textColor="@color/campus_mint_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_study_link"
                    app:iconGravity="textStart"
                    app:iconPadding="5dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/campus_mint_dark"
                    app:strokeColor="@color/campus_card_stroke" />
            </LinearLayout>

            <!-- 课表 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_campus_card"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/textTimetableCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:textColor="@color/campus_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/rowReimport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_study_import" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/study_timetable_import"
                        android:textColor="@color/campus_ink"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_campus_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/campus_card_stroke" />

                <LinearLayout
                    android:id="@+id/rowAddCourse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_study_add" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/study_timetable_add"
                        android:textColor="@color/campus_ink"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_campus_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/campus_card_stroke" />

                <LinearLayout
                    android:id="@+id/rowClearTimetable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_study_delete" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/study_timetable_clear"
                        android:textColor="@color/campus_danger"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 上课时间：冬令时与夏令时各存一套，可分别调整 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_campus_card"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/study_schedule_title"
                        android:textColor="@color/campus_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/study_schedule_season_note"
                        android:textColor="@color/campus_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipSeasonWinter"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_campus_soft_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/study_season_winter"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/chipSeasonSummer"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_campus_soft_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/study_season_summer"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 每天节数：上午/下午/晚课分别可调，节次连续编号 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/study_schedule_counts_title"
                        android:textColor="@color/campus_ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textTotalPeriods"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/campus_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/study_schedule_count_morning"
                        android:textColor="@color/campus_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/buttonMorningMinus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_campus_soft_circle"
                        android:clickable="true"
                        android:contentDescription="@string/study_schedule_count_minus"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/textMorningCount"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/buttonMorningPlus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_campus_soft_circle"
                        android:clickable="true"
                        android:contentDescription="@string/study_schedule_count_plus"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="18sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/campus_card_stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/study_schedule_count_afternoon"
                        android:textColor="@color/campus_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/buttonAfternoonMinus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_campus_soft_circle"
                        android:clickable="true"
                        android:contentDescription="@string/study_schedule_count_minus"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/textAfternoonCount"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/buttonAfternoonPlus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_campus_soft_circle"
                        android:clickable="true"
                        android:contentDescription="@string/study_schedule_count_plus"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="18sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/campus_card_stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/study_schedule_count_evening"
                        android:textColor="@color/campus_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/buttonEveningMinus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_campus_soft_circle"
                        android:clickable="true"
                        android:contentDescription="@string/study_schedule_count_minus"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/textEveningCount"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/buttonEveningPlus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_campus_soft_circle"
                        android:clickable="true"
                        android:contentDescription="@string/study_schedule_count_plus"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowMorningStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="11dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/study_schedule_morning"
                        android:textColor="@color/campus_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textMorningValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_campus_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/campus_card_stroke" />

                <LinearLayout
                    android:id="@+id/rowAfternoonStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="11dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/study_schedule_afternoon"
                        android:textColor="@color/campus_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textAfternoonValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_campus_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/campus_card_stroke" />

                <LinearLayout
                    android:id="@+id/rowEveningStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="11dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/study_schedule_evening"
                        android:textColor="@color/campus_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textEveningValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_campus_chevron_right" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/study_schedule_period_title"
                        android:textColor="@color/campus_ink"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textPeriodValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekPeriod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:max="90"
                    android:progress="15"
                    android:progressBackgroundTint="@color/campus_track"
                    android:progressTint="@color/campus_mint"
                    android:splitTrack="false"
                    android:thumbTint="@color/campus_mint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/study_schedule_break_title"
                        android:textColor="@color/campus_ink"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textBreakValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBreak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:max="30"
                    android:progress="10"
                    android:progressBackgroundTint="@color/campus_track"
                    android:progressTint="@color/campus_mint"
                    android:splitTrack="false"
                    android:thumbTint="@color/campus_mint" />

                <TextView
                    android:id="@+id/textScheduleSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/campus_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/textScheduleWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/campus_danger"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonResetPeriod"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/study_schedule_reset"
                    android:textColor="@color/campus_mint_dark"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/study_settings_hint"
                android:textColor="@color/campus_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
