<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_setup_bg"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_xl">
        <ImageButton
            android:id="@+id/buttonVirtualBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/campus_back"
            android:padding="@dimen/space_xl"
            android:src="@drawable/ic_campus_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:text="@string/virtual_title"
            android:textColor="@color/campus_ink"
            android:textSize="@dimen/text_hero"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
    style="@style/Text.Unloop.Action"
        android:id="@+id/textVirtualStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingHorizontal="@dimen/space_5xl"
        android:paddingBottom="@dimen/space_lg"
        android:text="@string/virtual_status_idle"
        />
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_weight="1">
        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView
            android:id="@+id/textMapTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/space_md"
            android:background="@drawable/bg_campus_chip"
            android:drawablePadding="5dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_xs"
            android:text="@string/campus_map_tag"
            android:textColor="@color/campus_ink"
            android:textSize="@dimen/text_caption"
            app:drawableStartCompat="@drawable/ic_campus_dot" />
        <TextView
            android:id="@+id/textMapLayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_7xl"
            android:background="@drawable/bg_campus_chip"
            android:clickable="true"
            android:contentDescription="@string/campus_map_layer_default_action"
            android:drawablePadding="5dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_xs"
            android:text="@string/campus_map_layer_satellite"
            android:textColor="@color/campus_mint_dark"
            android:textSize="@dimen/text_caption"
            app:drawableStartCompat="@drawable/ic_campus_layers" />
        <TextView
            android:id="@+id/textCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_margin="@dimen/space_md"
            android:background="@drawable/bg_campus_chip_dark"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingVertical="@dimen/space_xs"
            android:text="@string/placeholder"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_caption" />
        <TextView
            android:id="@+id/textVirtualHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/space_8xl"
            android:background="@drawable/bg_campus_chip"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingVertical="@dimen/space_sm"
            android:text="@string/virtual_hint"
            android:textColor="@color/campus_mint_dark"
            android:textSize="@dimen/text_caption" />
        <TextView
            android:id="@+id/textMapStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="@dimen/space_md"
            android:background="@drawable/bg_campus_chip"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingVertical="@dimen/space_xs"
            android:textColor="@color/fm_error"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/buttonMapPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/space_3xl"
            android:layout_marginBottom="@dimen/inset_fab_clear"
            android:contentDescription="@string/virtual_points"
            app:backgroundTint="@color/fm_surface"
            app:elevation="3dp"
            app:maxImageSize="24dp"
            app:srcCompat="@drawable/ic_campus_bookmark"
            app:tint="@color/fm_link" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/buttonLocateNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/space_3xl"
            android:contentDescription="@string/virtual_locate_now"
            app:backgroundTint="@color/fm_surface"
            app:elevation="3dp"
            app:maxImageSize="24dp"
            app:srcCompat="@drawable/ic_campus_locate_now"
            app:tint="@color/fm_link" />
    </FrameLayout>
    <!-- 搜索模式：地图与选点信息让位，结果列表在键盘弹出时也保持可见。 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/space_md"
        android:layout_weight="1"
        android:visibility="gone"
        app:cardBackgroundColor="@color/fm_surface"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="0dp"
        app:strokeColor="@color/fm_border"
        app:strokeWidth="@dimen/stroke_edge">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingVertical="@dimen/space_sm">
            <TextView
            style="@style/Text.Unloop.Note"
                android:id="@+id/textSearchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_xs"
                android:paddingVertical="@dimen/space_lg"
                android:visibility="gone" />
            <ScrollView
                android:id="@+id/searchResultsScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/searchResultsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
            <TextView
            style="@style/Text.Unloop.Caption"
                android:id="@+id/textSearchAttribution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_xs"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_hair"
                android:text="@string/virtual_search_attribution"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fm_surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_4xl"
        android:paddingTop="@dimen/space_2xl"
        android:paddingBottom="@dimen/space_3xl">
        <TextView
            android:id="@+id/textVirtualTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/virtual_target_none"
            android:textColor="@color/campus_ink"
            android:textSize="@dimen/text_lead"
            android:textStyle="bold" />
        <TextView
        style="@style/Text.Unloop.Note"
            android:id="@+id/textVirtualHintInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:lineSpacingExtra="2dp"
            android:text="@string/virtual_target_hint"
            />
        <LinearLayout
            android:id="@+id/pendingBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:baselineAligned="false"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:visibility="gone">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPendingCancel"
                style="@style/Widget.Unloop.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/virtual_pending_cancel"
                android:textColor="@color/campus_muted"
                android:textSize="@dimen/text_meta" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPendingConfirm"
                style="@style/Widget.Unloop.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/virtual_pending_confirm"
                android:textColor="@color/campus_mint_dark"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonVirtualMain"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_xl"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/virtual_start"
            android:textColor="@color/brand_on_primary"
            android:textSize="@dimen/text_title"
            app:backgroundTint="@color/campus_mint_dark"
            app:cornerRadius="@dimen/radius_card" />
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_virtual_search"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_2xl">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_campus_search" />
            <EditText
                android:id="@+id/inputPlaceSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_lg"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/virtual_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/campus_ink"
                android:textColorHint="@color/campus_muted"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
