<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_setup_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/buttonVirtualBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/campus_back"
            android:padding="13dp"
            android:src="@drawable/ic_campus_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/virtual_title"
            android:textColor="@color/campus_ink"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/textVirtualStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingHorizontal="24dp"
        android:paddingBottom="10dp"
        android:text="@string/virtual_status_idle"
        android:textColor="@color/campus_mint_dark"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/textMapTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_campus_chip"
            android:drawablePadding="5dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="9dp"
            android:paddingVertical="5dp"
            android:text="@string/campus_map_tag"
            android:textColor="@color/campus_ink"
            android:textSize="10sp"
            app:drawableStartCompat="@drawable/ic_campus_dot" />

        <TextView
            android:id="@+id/textMapLayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="8dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_campus_chip"
            android:clickable="true"
            android:contentDescription="@string/campus_map_layer_default_action"
            android:drawablePadding="5dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="9dp"
            android:paddingVertical="5dp"
            android:text="@string/campus_map_layer_satellite"
            android:textColor="@color/campus_mint_dark"
            android:textSize="10sp"
            app:drawableStartCompat="@drawable/ic_campus_layers" />

        <TextView
            android:id="@+id/textCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_margin="8dp"
            android:background="@drawable/bg_campus_chip_dark"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/placeholder"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/textVirtualHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="46dp"
            android:background="@drawable/bg_campus_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/virtual_hint"
            android:textColor="@color/campus_mint_dark"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/textMapStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="8dp"
            android:background="@drawable/bg_campus_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="@color/fm_error"
            android:textSize="10sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fm_surface"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/textVirtualTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/virtual_target_none"
            android:textColor="@color/campus_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/virtual_target_hint"
            android:textColor="@color/campus_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonVirtualMain"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/virtual_start"
            android:textColor="@color/brand_on_primary"
            android:textSize="16sp"
            app:backgroundTint="@color/campus_mint_dark"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
