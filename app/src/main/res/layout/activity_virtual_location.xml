<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_setup_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/buttonVirtualBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/campus_back"
            android:padding="13dp"
            android:src="@drawable/ic_campus_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/virtual_title"
            android:textColor="@color/campus_ink"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/textVirtualStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingHorizontal="24dp"
        android:paddingBottom="10dp"
        android:text="@string/virtual_status_idle"
        android:textColor="@color/campus_mint_dark"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/textMapTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_campus_chip"
            android:drawablePadding="5dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="9dp"
            android:paddingVertical="5dp"
            android:text="@string/campus_map_tag"
            android:textColor="@color/campus_ink"
            android:textSize="10sp"
            app:drawableStartCompat="@drawable/ic_campus_dot" />

        <TextView
            android:id="@+id/textMapLayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="8dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_campus_chip"
            android:clickable="true"
            android:contentDescription="@string/campus_map_layer_default_action"
            android:drawablePadding="5dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="9dp"
            android:paddingVertical="5dp"
            android:text="@string/campus_map_layer_satellite"
            android:textColor="@color/campus_mint_dark"
            android:textSize="10sp"
            app:drawableStartCompat="@drawable/ic_campus_layers" />

        <TextView
            android:id="@+id/textCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_margin="8dp"
            android:background="@drawable/bg_campus_chip_dark"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/placeholder"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/textVirtualHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="46dp"
            android:background="@drawable/bg_campus_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/virtual_hint"
            android:textColor="@color/campus_mint_dark"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/textMapStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="8dp"
            android:background="@drawable/bg_campus_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="@color/fm_error"
            android:textSize="10sp"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/buttonLocateNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/virtual_locate_now"
            app:backgroundTint="@color/fm_surface"
            app:elevation="3dp"
            app:maxImageSize="24dp"
            app:srcCompat="@drawable/ic_campus_locate_now"
            app:tint="@color/fm_link" />
    </FrameLayout>

    <!-- 搜索模式：地图与选点信息让位，结果列表在键盘弹出时也保持可见。 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:layout_weight="1"
        android:visibility="gone"
        app:cardBackgroundColor="@color/fm_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/fm_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/textSearchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:paddingVertical="10dp"
                android:textColor="@color/campus_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/searchResultsScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/searchResultsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/textSearchAttribution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp"
                android:text="@string/virtual_search_attribution"
                android:textColor="@color/campus_muted"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fm_surface"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/textVirtualTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/virtual_target_none"
            android:textColor="@color/campus_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textVirtualHintInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/virtual_target_hint"
            android:textColor="@color/campus_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonVirtualMain"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/virtual_start"
            android:textColor="@color/brand_on_primary"
            android:textSize="16sp"
            app:backgroundTint="@color/campus_mint_dark"
            app:cornerRadius="16dp" />

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_virtual_search"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_campus_search" />

            <EditText
                android:id="@+id/inputPlaceSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/virtual_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/campus_ink"
                android:textColorHint="@color/campus_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
