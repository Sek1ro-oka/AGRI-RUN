<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_5xl"
    android:paddingTop="@dimen/space_xs"
    android:paddingEnd="@dimen/space_5xl">
    <TextView
        style="@style/Text.Unloop.Body"
        android:id="@+id/textPresetConflictMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp" />
    <CheckBox
        android:id="@+id/checkPresetConflictDontAsk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:minHeight="@dimen/touch_min"
        android:text="@string/campus_preset_conflict_dont_ask"
        android:textColor="@color/campus_ink"
        android:textSize="@dimen/text_body" />
</LinearLayout>
