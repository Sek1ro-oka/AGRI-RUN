<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_4xl"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs">
        <TextView
        style="@style/Text.Unloop.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/study_homework_name"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/inputHomeworkName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_study_input"
            android:hint="@string/study_homework_name_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingVertical="@dimen/space_lg"
            android:textColor="@color/campus_ink"
            android:textColorHint="@color/fm_muted"
            android:textSize="@dimen/text_body" />
        <TextView
        style="@style/Text.Unloop.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/study_homework_deadline"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/rowHomeworkDeadline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_study_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_xl">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_study_clock" />
            <TextView
            style="@style/Text.Unloop.Body"
                android:id="@+id/textHomeworkDeadlineValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="@string/study_homework_deadline_pick"
                />
        </LinearLayout>
        <TextView
        style="@style/Text.Unloop.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/study_homework_lead"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/inputHomeworkLead"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_study_input"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/space_xl"
            android:textColor="@color/campus_ink"
            android:textSize="@dimen/text_body" />
        <TextView
        style="@style/Text.Unloop.Caption"
            android:id="@+id/textHomeworkRemindPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            />
    </LinearLayout>
</ScrollView>
