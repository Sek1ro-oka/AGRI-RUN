<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/study_homework_name"
            android:textColor="@color/campus_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputHomeworkName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_study_input"
            android:hint="@string/study_homework_name_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="@color/campus_ink"
            android:textColorHint="@color/fm_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/study_homework_deadline"
            android:textColor="@color/campus_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rowHomeworkDeadline"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_study_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_study_clock" />

            <TextView
                android:id="@+id/textHomeworkDeadlineValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="@string/study_homework_deadline_pick"
                android:textColor="@color/campus_ink"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/study_homework_lead"
            android:textColor="@color/campus_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputHomeworkLead"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_study_input"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:textColor="@color/campus_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textHomeworkRemindPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/campus_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
