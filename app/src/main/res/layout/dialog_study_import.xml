<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="6dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:text="@string/study_import_dialog_hint"
        android:textColor="@color/campus_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/textImportFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_study_input"
        android:ellipsize="middle"
        android:maxLines="1"
        android:padding="12dp"
        android:textColor="@color/campus_ink"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/textImportSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/campus_ink"
        android:textSize="12sp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkImportAppend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="0dp"
        android:paddingVertical="4dp"
        android:text="@string/study_import_append"
        android:textColor="@color/campus_ink"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textImportReplaceHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/campus_muted"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
