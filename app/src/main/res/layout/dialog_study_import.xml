<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_4xl"
        android:paddingTop="@dimen/space_sm">
        <TextView
            style="@style/Text.Unloop.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="@string/study_import_dialog_hint" />
        <TextView
            android:id="@+id/textImportFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_study_input"
            android:ellipsize="middle"
            android:maxLines="1"
            android:padding="@dimen/space_xl"
            android:textColor="@color/campus_ink"
            android:textSize="@dimen/text_meta" />
        <TextView
            android:id="@+id/textImportSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/campus_ink"
            android:textSize="@dimen/text_label" />
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkImportAppend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:minHeight="0dp"
            android:paddingVertical="@dimen/space_xs"
            android:text="@string/study_import_append"
            android:textColor="@color/campus_ink"
            android:textSize="@dimen/text_meta"
            android:visibility="gone" />
        <TextView
            style="@style/Text.Unloop.Caption"
            android:id="@+id/textImportReplaceHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
