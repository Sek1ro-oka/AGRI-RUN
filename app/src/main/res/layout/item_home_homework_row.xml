<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowHomeHomework"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/home_row_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <View
        android:id="@+id/viewHomeworkDot"
        android:layout_width="@dimen/space_sm"
        android:layout_height="@dimen/space_sm"
        android:background="@drawable/bg_home_dot" />
    <TextView
        android:id="@+id/textHomeworkTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_weight="1"
        android:textColor="@color/fm_text"
        android:textSize="@dimen/text_meta"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/textHomeworkDue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:textColor="@color/fm_warning"
        android:textSize="@dimen/text_caption"
        android:maxLines="1" />
</LinearLayout>
