<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowUpcomingCourse"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/home_row_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <TextView
        android:id="@+id/textUpcomingTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="44dp"
        android:gravity="end"
        android:textColor="@color/fm_text"
        android:textSize="@dimen/text_label"
        android:textStyle="bold" />
    <View
        android:id="@+id/viewUpcomingBar"
        android:layout_width="@dimen/space_hair"
        android:layout_height="@dimen/space_4xl"
        android:layout_marginStart="@dimen/space_sm"
        android:background="@drawable/bg_home_upcoming_bar" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/textUpcomingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fm_text"
            android:textSize="@dimen/text_meta"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/textUpcomingMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/fm_muted"
            android:textSize="@dimen/text_caption"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
    <TextView
        android:id="@+id/textUpcomingTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:background="@drawable/bg_home_tag_outline"
        android:paddingHorizontal="@dimen/space_sm"
        android:paddingVertical="1dp"
        android:textColor="@color/fm_muted"
        android:textSize="@dimen/text_caption"
        android:maxLines="1" />
</LinearLayout>
