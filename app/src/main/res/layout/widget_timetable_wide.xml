<?xml version="1.0" encoding="utf-8"?>
<!--
    双日课表小组件：左边今天（只列未结束的课），右边下一个有课日。
    只能用 RemoteViews 支持的控件；时间线由代码 addView 逐行追加。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetWideRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_campus_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp"
    tools:ignore="SmallSp,NestedWeights,DisableBaselineAlignment">

    <LinearLayout
        android:id="@+id/widgetWideColumns"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="46"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widgetWideDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/widget_timetable_wide_preview_date"
                    android:textColor="@color/campus_ink"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@color/fm_border" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widgetWideWeek"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/widget_timetable_wide_preview_week"
                        android:textColor="@color/campus_muted"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/widgetWideWeekday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/widget_timetable_wide_preview_weekday"
                        android:textColor="@color/campus_mint_dark"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widgetWideStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/widget_timetable_wide_preview_status"
                android:textColor="@color/campus_mint_dark"
                android:textSize="8sp" />

            <LinearLayout
                android:id="@+id/widgetWideLeftRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/widgetWideLeftFoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/campus_muted"
                android:textSize="7sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="7dp"
            android:background="@color/fm_border" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="54"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widgetWideNextDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_timetable_wide_preview_next"
                    android:textColor="@color/campus_ink"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widgetWideNextCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_timetable_wide_preview_count"
                    android:textColor="@color/campus_muted"
                    android:textSize="7sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widgetWideRightRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/widgetWideRightFoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/campus_muted"
                android:textSize="7sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widgetWideEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="12dp"
        android:textColor="@color/campus_muted"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
