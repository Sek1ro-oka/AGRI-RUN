<?xml version="1.0" encoding="utf-8"?>
<!--
  全站尺度唯一来源。布局里不要再写 sp/dp 字面值：`UiScaleTest` 会扫 res/layout 拦住新增的字面值，
  并拦住不足 48dp 的可点击控件。数值与实际显示保持一一对应，只把「谁都能改一个数」变成「改这里」。
-->
<resources>

    <!-- 文字阶梯。最小 11sp：再小的字在手机上要靠眯眼，读不动的说明等于没写。 -->
    <dimen name="text_caption">11sp</dimen>
    <dimen name="text_label">12sp</dimen>
    <dimen name="text_meta">13sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_lead">15sp</dimen>
    <dimen name="text_title">16sp</dimen>
    <dimen name="text_section">18sp</dimen>
    <dimen name="text_page_title">20sp</dimen>
    <dimen name="text_hero">22sp</dimen>
    <dimen name="text_metric">24sp</dimen>

    <!-- 间距阶梯。低密度（2/4/6/8）用在行内，高密度（20/24）用在版面分块。 -->
    <dimen name="space_hair">2dp</dimen>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">6dp</dimen>
    <dimen name="space_md">8dp</dimen>
    <dimen name="space_lg">10dp</dimen>
    <dimen name="space_xl">12dp</dimen>
    <dimen name="space_2xl">14dp</dimen>
    <dimen name="space_3xl">16dp</dimen>
    <dimen name="space_4xl">20dp</dimen>
    <dimen name="space_5xl">24dp</dimen>
    <dimen name="space_6xl">32dp</dimen>
    <dimen name="space_7xl">40dp</dimen>
    <dimen name="space_8xl">48dp</dimen>

    <!-- 阶梯外的两处：都按屏幕实际留白定出来的，不参与统一缩放。 -->
    <dimen name="inset_nav">56dp</dimen>
    <dimen name="inset_fab_clear">84dp</dimen>
    <dimen name="content_max_width">680dp</dimen>

    <!-- 圆角。控件与卡片差一档即可，再多就成了噪声。 -->
    <dimen name="radius_control">12dp</dimen>
    <dimen name="radius_card">16dp</dimen>
    <dimen name="radius_sheet">20dp</dimen>

    <!-- 触摸目标：手指点不准的按钮，做小就等于让人多点几次。 -->
    <dimen name="touch_min">48dp</dimen>
    <!-- 首页接下来/作业的紧凑行：44dp 仍接近触摸下限，用来把 6+2 收进首屏 -->
    <dimen name="home_row_height">44dp</dimen>

    <!-- 主页入口图标 32dp：这是用户自己挑过的大小，别再随手调。 -->
    <dimen name="icon_home">32dp</dimen>

    <dimen name="elevation_low">2dp</dimen>
    <dimen name="elevation_raised">8dp</dimen>
    <dimen name="stroke_edge">1dp</dimen>

</resources>
