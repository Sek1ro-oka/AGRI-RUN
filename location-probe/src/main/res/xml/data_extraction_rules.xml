<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- 定位探针不保存任何用户数据：云备份与设备迁移都整体排除。 -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
